FROM ros:humble-ros-core-jammy

SHELL ["/bin/bash", "-c"]
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
WORKDIR /app

COPY fog/planner/.config/install_dependencies.sh /tmp/install_dependencies.sh
RUN chmod +x /tmp/install_dependencies.sh && /tmp/install_dependencies.sh

COPY fog/planner/ros2ws/src /app/ros2ws/src

# The upstream build_lib.sh expects a Fields2Cover checkout that is not part of
# the trimmed planner tree. Build the Python package directly here while leaving
# that upstream-owned build helper unchanged; deployed planner source may carry
# the documented local compatibility fixes.
RUN cd /app/ros2ws/src/path_planning_lib && \
    python3 setup.py bdist_wheel && \
    python3 -m pip install --force-reinstall --no-deps dist/*.whl && \
    python3 -m pip install --no-cache-dir --force-reinstall "numpy<2" && \
    source /opt/ros/humble/setup.bash && \
    cd /app/ros2ws && \
    colcon build

COPY docker/entrypoint-planner.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]
